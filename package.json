{
  "name": "react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm lint && vite build",
    "lint": "pnpm check-types && pnpm eslint && pnpm prettier:check",
    "lint:fix": "pnpm eslint:fix && pnpm prettier:fix",
    "eslint": "eslint --cache --max-warnings=0 --ext .ts,.tsx .",
    "eslint:fix": "pnpm eslint --fix",
    "eslint:check": "cross-env eslint --cache --max-warnings=0 --ext .ts,.tsx .",
    "prettier:check": "prettier --check \"**/*.ts\" \"**/*.tsx\"",
    "prettier:fix": "prettier --write \"**/*.ts\" \"**/*.tsx\"",
    "check-types": "tsc --noemit",
    "preview": "vite preview",
    "commitlint": "commitlint",
    "prepare": "node checkHusky.js"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "pnpm exec eslint --fix",
      "pnpm exec prettier --write"
    ]
  },
  "dependencies": {
    "@generouted/react-router": "^1.20.2",
    "@hookform/resolvers": "^5.9.0",
    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^10.0.0",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.20.0",
    "blurhash": "^2.0.5",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "lucide-react": "^0.556.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.85.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.2",
    "react-select": "^5.10.2",
    "react-toastify": "^11.1.0",
    "recoil": "^0.7.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@types/crypto-js": "^4.2.2",
    "@types/lodash": "^4.17.25",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "add": "^2.0.9",
    "autoprefixer": "^10.5.4",
    "cross-env": "^10.1.0",
    "crypto-js": "^4.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "lodash.debounce": "^4.0.8",
    "pnpm": "^10.34.5",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^5.1.4"
  }
}